{
  "compilerOptions": {
    "outDir": "./dist/server",
    "rootDir": "./server",

    "types": ["node"],

    "composite": true,
    "skipLibCheck": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "strict": true
  },
  "include": ["./server"]
}
