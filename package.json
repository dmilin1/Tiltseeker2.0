{
  "name": "tiltseeker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node ./dist/server/index.js",
    "server": "tsx watch ./server/index.ts --tsconfig ./tsconfig.server.json",
    "client": "vite --base=/react",
